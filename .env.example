# LAN: reachable at http://<private-LAN-IP>:9791 with username and password.
# Restrict TCP/9791 to your LAN and authorized proxy using the host firewall.
SWITCHYARD_BIND=0.0.0.0
# Optional: additional LAN DNS origins, comma-separated (e.g. http://switchyard.lan:9791).
LAN_ORIGINS=
# Optional remote access, only through an HTTPS reverse proxy preserving Host.
# Once configured, TOTP is mandatory on ALL requests through this public origin.
# Enroll TOTP under Settings from the LAN before enabling remote access.
PUBLIC_ORIGIN=
# HTTPS uses Secure cookies; LAN HTTP uses host-scoped non-Secure cookies.
COOKIE_SECURE=true
# Only for a trusted internal HTTP Vaultwarden instance, never on public networks:
ALLOW_HTTP_VAULT=false
